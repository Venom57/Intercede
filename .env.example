# Copy to .env and fill in. .env is gitignored — never commit it.

# Long random value; sessions are signed with this. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Postgres password (used by both db and api services)
POSTGRES_PASSWORD=

# Public URL of the app — printed inside the QR poster join links,
# e.g. https://prayer.example.com
PUBLIC_BASE_URL=

# Cloudflare Tunnel token: Cloudflare dashboard -> Zero Trust -> Networks ->
# Tunnels -> Create a tunnel (Cloudflared connector) -> copy the token from
# the docker run snippet. Then add a Public Hostname for your domain pointing
# to  http://web:80
TUNNEL_TOKEN=
